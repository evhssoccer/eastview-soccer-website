---
/** Small outline icon for a social link. Uses currentColor, so it matches the link it sits in. */
interface Props { name: "facebook" | "instagram" | "x" }
const { name } = Astro.props;
---
<svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"
  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {name === "facebook" && (
    <>
      <circle cx="12" cy="12" r="10" />
      <path d="M15 7.5h-1.5a2.5 2.5 0 0 0-2.5 2.5v12" />
      <path d="M8.5 13H15" />
    </>
  )}
  {name === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
    </>
  )}
  {name === "x" && (
    <>
      <path d="M4 4l16 16" />
      <path d="M20 4L4 20" stroke-width="1.4" />
    </>
  )}
</svg>

<style>
  .social-icon { display: inline-block; flex: none; width: 1.15em; height: 1.15em; vertical-align: -0.22em; margin-right: 7px; }
</style>
